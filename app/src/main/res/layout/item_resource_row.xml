<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_resource_row"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivResourceIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@android:drawable/ic_menu_help"
        app:tint="@color/primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvResourceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deep Learning Specialization"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/text_primary_dark" />

        <TextView
            android:id="@+id/tvResourceSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coursera · Free Audit"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@android:drawable/ic_media_play"
        app:tint="@color/primary" />

</LinearLayout>
