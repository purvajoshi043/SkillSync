<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to SkillSync"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Let's personalize your experience."
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvRoleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="What role are you targeting?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary_dark"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent" />

    <RadioGroup
        android:id="@+id/rgRoles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvRoleLabel"
        app:layout_constraintStart_toStartOf="parent">

        <RadioButton
            android:id="@+id/rbBusiness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Business Analyst"
            android:textSize="16sp"
            android:padding="16dp" />

        <RadioButton
            android:id="@+id/rbDesigner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Graphic Designer"
            android:textSize="16sp"
            android:padding="16dp" />

        <RadioButton
            android:id="@+id/rbMarketing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Marketing Manager"
            android:textSize="16sp"
            android:padding="16dp" />

        <RadioButton
            android:id="@+id/rbHR"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HR Specialist"
            android:textSize="16sp"
            android:padding="16dp" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvExpLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="What is your experience level?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary_dark"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/rgRoles"
        app:layout_constraintStart_toStartOf="parent" />

    <RadioGroup
        android:id="@+id/rgExperience"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/tvExpLabel"
        app:layout_constraintStart_toStartOf="parent">

        <RadioButton
            android:id="@+id/rbBeginner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Beginner" />

        <RadioButton
            android:id="@+id/rbIntermediate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Inter." />

        <RadioButton
            android:id="@+id/rbAdvanced"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Adv." />
    </RadioGroup>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Continue"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:cornerRadius="16dp"
        app:backgroundTint="@color/primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
